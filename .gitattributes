# Normalize text by default; specific source files below are pinned to LF.
* text=auto

# Source, templates, docs, and config should not churn line endings.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
Makefile text eol=lf

# Windows helper scripts should keep Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.webp binary
*.xlsx binary
*.xls binary
*.zip binary
